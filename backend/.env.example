# Backend Environment Variables (.env.example)

# Backend Server Port
PORT=3001

# MongoDB Connection String:
# Local option: mongodb://localhost:27017/cream-treat
# MongoDB Atlas option: mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/cream-treat?retryWrites=true&w=majority
DATABASE_URL=mongodb://localhost:27017/cream-treat

# Secret used to sign and verify Admin JWT tokens
JWT_SECRET=your_jwt_secret_key_change_in_production

# Frontend Application Origin for CORS configuration
FRONTEND_URL=http://localhost:3000

# Development Seed Admin Account (Change in production!)
SEED_ADMIN_NAME=Cream Treat Admin
SEED_ADMIN_EMAIL=admin@creamtreat.local
SEED_ADMIN_PASSWORD=Admin@CreamTreat2026!
