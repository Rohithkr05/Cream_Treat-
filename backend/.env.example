# ==============================================================================
# CREAM TREAT — BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env for local development or configure these variables
# in your production cloud hosting provider (e.g. Render, Railway, AWS, Fly.io).
#
# NEVER commit production passwords, connection strings, or JWT secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Runtime & Port
# ------------------------------------------------------------------------------
# Local Development:      development
# Production:             production (enforces strict CORS, hides stack traces)
NODE_ENV=development
PORT=3001

# ------------------------------------------------------------------------------
# 2. Database Connection String (MongoDB)
# ------------------------------------------------------------------------------
# Local Development:      mongodb://localhost:27017/cream-treat
# Production (Atlas):     mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/cream-treat?retryWrites=true&w=majority
DATABASE_URL=mongodb://localhost:27017/cream-treat

# ------------------------------------------------------------------------------
# 3. Authentication & JWT Security
# ------------------------------------------------------------------------------
# Generate a cryptographically secure random 64-character secret in production
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cream_treat_dev_secret_key_2026_qr_ordering
JWT_EXPIRES_IN=1d

# ------------------------------------------------------------------------------
# 4. Allowed Frontend CORS Origin(s)
# ------------------------------------------------------------------------------
# Configures CORS whitelist for both the REST API and Socket.IO gateway.
# In development (NODE_ENV !== 'production'), localhost and local LAN IPs (192.168.x.x)
# are automatically permitted for ease of testing.
# In production, ONLY origins explicitly listed here are accepted.
# Can be a single URL or comma-separated list:
# Production:             https://order.creamtreat.com,https://admin.creamtreat.com
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 5. Default Seed Admin Account (Initialized on first database startup)
# ------------------------------------------------------------------------------
SEED_ADMIN_NAME=Cream Treat Admin
SEED_ADMIN_EMAIL=admin@creamtreat.local
SEED_ADMIN_PASSWORD=Admin@CreamTreat2026!
