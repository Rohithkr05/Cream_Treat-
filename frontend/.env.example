# ==============================================================================
# CREAM TREAT — FRONTEND ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env.local for local overrides or configure these variables
# in your cloud deployment platform (e.g. Vercel, Netlify, Cloudflare Pages).
#
# IMPORTANT FOR MOBILE 4G/5G ACCESS:
# To allow customers to scan QR codes using their phone's mobile cellular data
# without connecting to shop Wi-Fi, NEXT_PUBLIC_APP_URL, NEXT_PUBLIC_API_URL,
# and NEXT_PUBLIC_SOCKET_URL MUST point to a valid public HTTPS domain.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base Application Domain (Encoded into physical table QR standees)
# ------------------------------------------------------------------------------
# Local Development:      http://localhost:3000
# Shop Wi-Fi Testing:     http://192.168.1.100:3000 (Requires phone to join shop Wi-Fi)
# Production (4G/5G):     https://order.creamtreat.com (or https://cream-treat.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Backend REST API Base URL
# ------------------------------------------------------------------------------
# Local Development:      http://localhost:3001
# Shop Wi-Fi Testing:     http://192.168.1.100:3001
# Production (4G/5G):     https://api.creamtreat.com (or https://cream-treat-api.onrender.com)
NEXT_PUBLIC_API_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# 3. Socket.IO Real-Time Server URL (Order updates & Admin notifications)
# ------------------------------------------------------------------------------
# Local Development:      http://localhost:3001
# Shop Wi-Fi Testing:     http://192.168.1.100:3001
# Production (4G/5G):     https://api.creamtreat.com (or https://cream-treat-api.onrender.com)
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
