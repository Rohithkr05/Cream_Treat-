# Frontend Environment Variables (.env.example)

# Backend REST API Base URL
# Local Development: http://localhost:3001
# Mobile LAN Testing: http://<YOUR_LAN_IP>:3001 (e.g. http://192.168.1.10:3001) or leave empty for auto-detection in browser
# Production: https://api.creamtreat.com
NEXT_PUBLIC_API_URL=http://localhost:3001

# Backend Socket.IO Server URL (same host/port as REST API)
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Application Domain / Base URL used for customer table QR codes
# Local Development: http://localhost:3000
# Mobile LAN Testing: http://<YOUR_LAN_IP>:3000 (e.g. http://192.168.1.10:3000)
# Production: https://order.creamtreat.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
