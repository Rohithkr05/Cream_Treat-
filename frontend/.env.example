# Frontend Environment Variables (.env.example)

# Backend REST API Base URL (e.g. http://localhost:3001)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Backend Socket.IO Server URL (e.g. http://localhost:3001)
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Application Domain / Base URL used for customer table QR codes (e.g. http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000
